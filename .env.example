# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=replace_with_your_api_key

# Optional model providers. Store this file as .env on your Windows PC.
# Do not upload keys or paste them into chat. External services also bill by API usage.
ANTHROPIC_API_KEY=replace_with_your_anthropic_key
DEEPSEEK_API_KEY=replace_with_your_deepseek_key

# v0.11 optional AI provider keys. You choose providers ONCE; APEX chooses models per task.
# Never paste these keys into chat or commit your populated .env file.
OPENROUTER_API_KEY=replace_with_your_openrouter_key
GROQ_API_KEY=replace_with_your_groq_key
HF_TOKEN=replace_with_your_huggingface_token
MISTRAL_API_KEY=replace_with_your_mistral_key
TOGETHER_API_KEY=replace_with_your_together_key
FIREWORKS_API_KEY=replace_with_your_fireworks_key
CEREBRAS_API_KEY=replace_with_your_cerebras_key
DEEPINFRA_API_KEY=replace_with_your_deepinfra_key
